APP_NAME=Maestro AI
# "development" prints password-reset OTPs to the console when SMTP is not configured.
# Use "production" in deployments so OTPs never appear in logs.
NODE_ENV=development
HOST=0.0.0.0
PORT=5050
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:4173,http://localhost
ASSISTANT_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
APP_DATABASE_PATH=./data/drafts.db
# Optional: set a Postgres URL to use Postgres instead of SQLite
DATABASE_URL=
NVIDIA_NIM_TIMEOUT_SECONDS=180
NVIDIA_NIM_RETRIES=1
# Optional: leave empty to auto-detect `fluidsynth` on PATH. Windows example:
# FLUIDSYNTH_PATH=./tools/fluidsynth/dist/fluidsynth-v2.5.4-win10-x64-cpp11/bin/fluidsynth.exe
FLUIDSYNTH_PATH=
SOUNDFONT_PATH=./assets/soundfonts/MuseScore_General.sf3

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=noreply@example.com
SMTP_USE_TLS=True
# Use Brevo (HTTPS) instead of SMTP on hosts that block SMTP ports, e.g. Render free plan.
# SMTP_SENDER must be a sender verified in Brevo.
BREVO_API_KEY=
